{
  "service": {
    "name": "loadshed",
    "version": "1.0.0",
    "description": "LoadShed Service - Load Shedding Management"
  },
  "api_server": {
    "host": "0.0.0.0",
    "port": 8080,
    "max_connections": 100
  },
  "mqtt": {
    "broker_host": "mosquitto",
    "broker_port": 1883,
    "client_id": "loadshed",
    "keepalive": 60,
    "qos": 1,
    "topics": {
      "subscribe": [
        "device/+/data",
        "system/commands/#"
      ],
      "publish": [
        "system/status",
        "system/events"
      ]
    }
  },
  "database": {
    "enabled": false,
    "host": "postgres",
    "port": 5432,
    "dbname": "microservice_db",
    "user": "postgres",
    "password": "postgres"
  },
  "logging": {
    "level": "info",
    "file": "/app/logs/loadshed.log",
    "console": true,
    "max_file_size_mb": 10,
    "max_files": 5
  },
  "health_check": {
    "interval_seconds": 30,
    "timeout_seconds": 5
  },
  "custom": {
    "note": "Add your custom configuration here"
  }
}

